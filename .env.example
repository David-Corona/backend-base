# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/base_app?schema=public

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
PASSWORD_RESET_TOKEN_EXPIRATION=1h
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTH=10

# Resend
RESEND_API_KEY=change-me
FROM_EMAIL=noreply@example.com

# Frontend
FRONTEND_URL=http://localhost:4200

# Security
# ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# TRUST_PROXY=1  # Set to number of proxy hops when behind a reverse proxy (default: 0)

# Logging
LOG_REQUEST_BODIES=false
LOG_RESPONSE_BODIES=true

# Admin (Swagger docs access)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
