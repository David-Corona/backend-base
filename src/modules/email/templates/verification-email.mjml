<mjml lang="en">
  <mj-head>
    <mj-title>Verify your email</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-button font-size="16px" font-weight="bold" background-color="#4A90D9" color="#ffffff" border-radius="8px" inner-padding="12px 24px" />
    </mj-attributes>
    <mj-style>
      .token-box {
        background-color: #f5f5f5;
        border-radius: 8px;
        padding: 16px;
        font-size: 20px;
        font-weight: bold;
        word-break: break-all;
        text-align: center;
        border: 1px solid #e0e0e0;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9f9f9">
    <mj-section background-color="#ffffff" padding="20px 0">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#333333" padding-bottom="16px">
          Verify your email address
        </mj-text>
        <mj-text padding="0 16px 16px">
          Thank you for signing up. Please use the token below to verify your email address:
        </mj-text>
        <mj-text css-class="token-box" padding="0 16px 16px">
          {{token}}
        </mj-text>
        <mj-text padding="0 16px 16px" color="#666666" font-size="14px">
          Or visit the verification page and enter the token above.
        </mj-text>
        <mj-text align="center" padding="16px" color="#666666" font-size="14px">
          This token expires in {{expiresIn}}.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0">
      <mj-column>
        <mj-text align="center" color="#999999" font-size="12px">
          If you didn't create an account, no further action is required.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
